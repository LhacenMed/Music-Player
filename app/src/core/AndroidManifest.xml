<?xml version="1.0" encoding="utf-8"?>
<!--
    The in-app updater is core-only: gplay updates through Play, foss through F-Droid, and both
    expect to be the only thing offering one. Merged into the manifest for this flavor alone, so
    neither the permission nor the service exists in a build meant to go through a store.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application>
        <service
            android:name=".update.UpdateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
