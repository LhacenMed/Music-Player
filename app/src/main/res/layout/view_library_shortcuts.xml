<?xml version="1.0" encoding="utf-8"?>
<!-- The three fixed entry points into the library, sitting between the search bar and the tabs.
     Their size never depends on their contents, so the tabs below them never shift. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="@dimen/activity_margin"
    android:paddingEnd="@dimen/activity_margin"
    android:paddingBottom="@dimen/small_margin">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/shortcut_favorites"
        style="@style/Widget.LibraryShortcut"
        android:layout_marginEnd="@dimen/small_margin">

        <LinearLayout style="@style/Widget.LibraryShortcut.Content">

            <ImageView
                android:id="@+id/shortcut_favorites_icon"
                style="@style/Widget.LibraryShortcut.Icon"
                android:contentDescription="@string/favorites"
                android:src="@drawable/ic_favorite_on_24" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/shortcut_favorites_label"
                style="@style/Widget.LibraryShortcut.Label"
                android:text="@string/favorites" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/shortcut_playlists"
        style="@style/Widget.LibraryShortcut"
        android:layout_marginEnd="@dimen/small_margin"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout style="@style/Widget.LibraryShortcut.Content">

            <ImageView
                android:id="@+id/shortcut_playlists_icon"
                style="@style/Widget.LibraryShortcut.Icon"
                android:contentDescription="@string/playlists"
                android:src="@drawable/ic_playlist_vector" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/shortcut_playlists_label"
                style="@style/Widget.LibraryShortcut.Label"
                android:text="@string/playlists" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/shortcut_recent"
        style="@style/Widget.LibraryShortcut">

        <LinearLayout style="@style/Widget.LibraryShortcut.Content">

            <ImageView
                android:id="@+id/shortcut_recent_icon"
                style="@style/Widget.LibraryShortcut.Icon"
                android:contentDescription="@string/recent"
                android:src="@drawable/ic_recent_24" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/shortcut_recent_label"
                style="@style/Widget.LibraryShortcut.Label"
                android:text="@string/recent" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
