<?xml version="1.0" encoding="utf-8"?>
<!-- The three fixed entry points into the library, sitting between the search bar and the tabs.
     Built from the same expressive widgets as the transport row in the playback panel: a
     MaterialButtonGroup gives the press squish and the shape morph, and the outlined buttons take
     their colours from the accent in MainActivity, exactly as PlaybackPanel.updateColors() does.
     The weights are what keep the row evenly divided, so the tabs below it never shift.

     The order is fixed left to right in every locale, the way the transport controls are, so the
     entry point a user reaches for never moves. -->
<org.fossify.musicplayer.views.ForcedLTRFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/activity_margin"
    android:paddingEnd="@dimen/activity_margin"
    android:paddingBottom="@dimen/small_margin">

    <com.google.android.material.button.MaterialButtonGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:spacing="@dimen/spacing_small"
        app:shapeAppearance="@xml/library_shortcut_shape">

        <org.fossify.musicplayer.views.LibraryShortcutButton
            android:id="@+id/shortcut_favorites"
            style="@style/Widget.LibraryShortcut"
            android:text="@string/favorites"
            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Small"
            app:shortcutIcon="@drawable/ic_favorite_on_24" />

        <org.fossify.musicplayer.views.LibraryShortcutButton
            android:id="@+id/shortcut_playlists"
            style="@style/Widget.LibraryShortcut"
            android:text="@string/playlists"
            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Small"
            app:shortcutIcon="@drawable/ic_playlist_vector" />

        <org.fossify.musicplayer.views.LibraryShortcutButton
            android:id="@+id/shortcut_recent"
            style="@style/Widget.LibraryShortcut"
            android:text="@string/recent"
            app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Small"
            app:shortcutIcon="@drawable/ic_recent_24" />

    </com.google.android.material.button.MaterialButtonGroup>

</org.fossify.musicplayer.views.ForcedLTRFrameLayout>
