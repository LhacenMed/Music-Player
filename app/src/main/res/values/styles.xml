<resources>

    <style name="AppTheme" parent="AppTheme.Base">
        <!-- Transparent system bars, so whatever is drawn behind them supplies the colour. This is
             what makes the status bar follow the playback panel as it covers the screen. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Corner radius, globalised. Material components resolve their shapes from these, so
             every dialog, sheet, button, card and input follows the one scale. -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.App.Small</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.App.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.App.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.App.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.App.Large</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.Large</item>
    </style>

    <!-- Fossify Commons' BaseSimpleActivity swaps in one of its own accent-coloured themes via
         setTheme(getThemeId()) in both onCreate() and onResume(), replacing AppTheme wholesale -
         so typography set here never survives. SimpleActivity re-applies this overlay on top of
         that swapped-in theme instead, right after each of those calls. -->
    <style name="ThemeOverlay.App.Typography" parent="">
        <!-- Typography, ported from Auxio: Inter throughout, with per-size letter-spacing. -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.App.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.App.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.App.DisplaySmall</item>
        <item name="textAppearanceDisplayLargeEmphasized">@style/TextAppearance.App.DisplayLarge.Emphasized</item>
        <item name="textAppearanceDisplayMediumEmphasized">@style/TextAppearance.App.DisplayMedium.Emphasized</item>
        <item name="textAppearanceDisplaySmallEmphasized">@style/TextAppearance.App.DisplaySmall.Emphasized</item>

        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.HeadlineSmall</item>
        <item name="textAppearanceHeadlineLargeEmphasized">@style/TextAppearance.App.HeadlineLarge.Emphasized</item>
        <item name="textAppearanceHeadlineMediumEmphasized">@style/TextAppearance.App.HeadlineMedium.Emphasized</item>
        <item name="textAppearanceHeadlineSmallEmphasized">@style/TextAppearance.App.HeadlineSmall.Emphasized</item>

        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.App.TitleSmall</item>
        <item name="textAppearanceTitleLargeEmphasized">@style/TextAppearance.App.TitleLarge.Emphasized</item>
        <item name="textAppearanceTitleMediumEmphasized">@style/TextAppearance.App.TitleMedium.Emphasized</item>
        <item name="textAppearanceTitleSmallEmphasized">@style/TextAppearance.App.TitleSmall.Emphasized</item>

        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.App.LabelSmall</item>
        <item name="textAppearanceLabelLargeEmphasized">@style/TextAppearance.App.LabelLarge.Emphasized</item>
        <item name="textAppearanceLabelMediumEmphasized">@style/TextAppearance.App.LabelMedium.Emphasized</item>
        <item name="textAppearanceLabelSmallEmphasized">@style/TextAppearance.App.LabelSmall.Emphasized</item>

        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.BodySmall</item>
        <item name="textAppearanceBodyLargeEmphasized">@style/TextAppearance.App.BodyLarge.Emphasized</item>
        <item name="textAppearanceBodyMediumEmphasized">@style/TextAppearance.App.BodyMedium.Emphasized</item>
        <item name="textAppearanceBodySmallEmphasized">@style/TextAppearance.App.BodySmall.Emphasized</item>

        <!-- The textAppearance* attrs above only reach views that resolve a Material3 type-scale
             role. Plain TextViews and EditTexts - including the ones inside Fossify Commons'
             own layouts - fall back to whatever these default widget styles set instead, so Inter
             has to be the default font here too for it to cover the whole app. -->
        <item name="android:textViewStyle">@style/Widget.App.TextView</item>
        <item name="android:editTextStyle">@style/Widget.App.EditText</item>
    </style>

    <style name="Widget.App.TextView" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>

    <style name="Widget.App.EditText" parent="Widget.AppCompat.EditText">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>

    <style name="ShapeAppearance.App.Tiny" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/corner_radius_tiny</item>
    </style>

    <style name="ShapeAppearance.App.Small" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/corner_radius_small</item>
    </style>

    <style name="ShapeAppearance.App.Medium" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/corner_radius_medium</item>
    </style>

    <style name="ShapeAppearance.App.Large" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">@dimen/corner_radius_large</item>
    </style>

    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="ShapeAppearance.PlaybackSheet" parent="ShapeAppearance.App.Large" />

    <!-- Lets the sheet draw all the way under the navigation bar, the way the queue sheet does,
         instead of the dialog reserving a blank strip for it. -->
    <style name="Widget.TrackMenu.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="marginLeftSystemWindowInsets">false</item>
        <item name="marginRightSystemWindowInsets">false</item>
        <item name="paddingBottomSystemWindowInsets">false</item>
        <item name="paddingTopSystemWindowInsets">false</item>
        <item name="shouldRemoveExpandedCorners">false</item>
    </style>

    <style name="ThemeOverlay.TrackMenu.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.TrackMenu.BottomSheet</item>
        <item name="enableEdgeToEdge">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.TrackMenu.BottomSheetDialog</item>
    </style>

    <!-- Material's sheet transition fades the dialog while sliding it only a fifth of the way, so
         the sheet appears most of the way up and the fade covers for it. Auxio's replacement drops
         the fade and travels the full height instead, which is the same motion the playback sheet
         makes. -->
    <style name="Animation.TrackMenu.BottomSheetDialog" parent="Animation.Material3.BottomSheetDialog">
        <item name="android:windowEnterAnimation">@anim/bottom_sheet_slide_in</item>
        <item name="android:windowExitAnimation">@anim/bottom_sheet_slide_out</item>
    </style>

    <style name="Widget.QueueTrack.DisableDropShadows" parent="">
        <item name="android:outlineAmbientShadowColor">@android:color/transparent</item>
        <item name="android:outlineSpotShadowColor">@android:color/transparent</item>
    </style>

    <style name="Widget.QueueTrack.Primary" parent="Widget.AppCompat.TextView">
        <item name="android:textAlignment">viewStart</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:layout_marginStart">@dimen/spacing_medium</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">@color/sel_selectable_text_primary</item>
    </style>

    <style name="Widget.QueueTrack.Secondary" parent="Widget.AppCompat.TextView">
        <item name="android:textAlignment">viewStart</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:layout_marginStart">@dimen/spacing_medium</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">@color/sel_selectable_text_secondary</item>
    </style>

    <style name="Widget.QueueTrack.Handle" parent="Widget.Material3Expressive.Button.IconButton">
        <item name="materialThemeOverlay">@style/ThemeOverlay.PlaybackButton.UncheckableIcon</item>
        <item name="iconSize">@dimen/size_icon_small</item>
        <item name="android:minWidth">@dimen/size_touchable_small</item>
        <item name="android:minHeight">@dimen/size_touchable_small</item>
        <item name="android:insetTop">@dimen/spacing_tiny</item>
        <item name="android:insetBottom">@dimen/spacing_tiny</item>
        <item name="android:insetLeft">@dimen/spacing_tiny</item>
        <item name="android:insetRight">@dimen/spacing_tiny</item>
        <item name="android:paddingStart">@dimen/spacing_small</item>
        <item name="android:paddingEnd">@dimen/spacing_small</item>
        <item name="android:paddingTop">@dimen/spacing_small</item>
        <item name="android:paddingBottom">@dimen/spacing_small</item>
    </style>

    <!-- Track rows, ported from Auxio's song item. One line each, so a long title or a missing
         artist never changes the height of the row. -->
    <style name="Widget.TrackItem.Base" parent="Widget.AppCompat.TextView">
        <item name="android:textAlignment">viewStart</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:layout_marginStart">@dimen/spacing_medium</item>
    </style>

    <style name="Widget.TrackItem.Primary" parent="Widget.TrackItem.Base">
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="Widget.TrackItem.Secondary" parent="Widget.TrackItem.Base">
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="Widget.TrackItem.Menu" parent="Widget.Material3Expressive.Button.IconButton">
        <item name="materialThemeOverlay">@style/ThemeOverlay.PlaybackButton.UncheckableIcon</item>
        <item name="iconSize">@dimen/size_icon_small</item>
        <item name="android:minWidth">@dimen/size_touchable_small</item>
        <item name="android:minHeight">@dimen/size_touchable_small</item>
        <item name="android:insetTop">@dimen/spacing_tiny</item>
        <item name="android:insetBottom">@dimen/spacing_tiny</item>
        <item name="android:insetLeft">@dimen/spacing_tiny</item>
        <item name="android:insetRight">@dimen/spacing_tiny</item>
        <item name="android:paddingStart">@dimen/spacing_small</item>
        <item name="android:paddingEnd">@dimen/spacing_small</item>
        <item name="android:paddingTop">@dimen/spacing_small</item>
        <item name="android:paddingBottom">@dimen/spacing_small</item>
    </style>

    <style name="Widget.TrackText.Primary" parent="Widget.AppCompat.TextView">
        <item name="android:textAlignment">viewStart</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:singleLine">true</item>
        <item name="android:marqueeRepeatLimit">marquee_forever</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleLargeEmphasized</item>
    </style>

    <style name="Widget.TrackText.Secondary.Marquee" parent="Widget.AppCompat.TextView">
        <item name="android:textAlignment">viewStart</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:marqueeRepeatLimit">marquee_forever</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
    </style>

    <style name="Widget.TrackText.Primary.Compact" parent="Widget.AppCompat.TextView">
        <item name="android:textAlignment">viewStart</item>
        <item name="android:ellipsize">marquee</item>
        <item name="android:singleLine">true</item>
        <item name="android:marqueeRepeatLimit">marquee_forever</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLargeEmphasized</item>
    </style>

    <style name="Widget.TrackText.Secondary.Compact" parent="Widget.AppCompat.TextView">
        <item name="android:textAlignment">viewStart</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
    </style>

    <style name="Widget.CurrentTrackProgress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackCornerRadius">@dimen/m3_shape_corners_full</item>
        <item name="trackStopIndicatorSize">0dp</item>
    </style>

    <style name="Widget.PlaybackButton.More" parent="Widget.Material3Expressive.Button.IconButton">
        <item name="materialThemeOverlay">@style/ThemeOverlay.PlaybackButton.UncheckableIcon</item>
    </style>

    <style name="ThemeOverlay.PlaybackButton.UncheckableIcon" parent="">
        <item name="colorContainer">@android:color/transparent</item>
        <item name="colorOnContainer">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.PlaybackButton.Toggle" parent="Widget.Material3Expressive.Button.IconButton.Outlined">
        <item name="android:checkable">true</item>
        <item name="toggleCheckedStateOnClick">false</item>
        <item name="iconTint">@color/sel_checkable_icon</item>
        <item name="strokeColor">@color/sel_checkable_outline</item>
    </style>

    <style name="Widget.PlaybackButton.Skip" parent="Widget.Material3Expressive.Button.IconButton.Tonal" />

    <style name="Widget.PlaybackButton.PlayPause" parent="Widget.Material3Expressive.Button.IconButton.Tonal">
        <item name="android:checkable">true</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.PlaybackButton.PrimaryTonal</item>
    </style>

    <style name="ThemeOverlay.PlaybackButton.PrimaryTonal" parent="">
        <item name="colorContainer">?attr/colorPrimaryContainer</item>
        <item name="colorContainerChecked">?attr/colorPrimary</item>
        <item name="colorContainerUnchecked">?attr/colorPrimaryContainer</item>
        <item name="colorOnContainer">?attr/colorOnPrimaryContainer</item>
        <item name="colorOnContainerChecked">?attr/colorOnPrimary</item>
        <item name="colorOnContainerUnchecked">?attr/colorOnPrimaryContainer</item>
    </style>

    <style name="Widget.LyricLine" parent="">
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">@color/sel_lyric_line</item>
    </style>

    <style name="Widget.LyricLine.Placeholder">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:alpha">0.6</item>
    </style>

    <!-- Lines wrap rather than ellipsize here, as the reading view has the room for it. Kept out
         of the Widget.LyricLine hierarchy so it does not inherit that style's single-line cap. -->
    <style name="Widget.LyricLineLarge" parent="">
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:paddingStart">@dimen/spacing_medium</item>
        <item name="android:paddingEnd">@dimen/spacing_medium</item>
        <item name="android:paddingTop">@dimen/spacing_mid_large</item>
        <item name="android:paddingBottom">@dimen/spacing_mid_large</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleLarge</item>
        <item name="android:textColor">@color/sel_lyric_line</item>
    </style>

    <style name="Widget.PlaybackSlider" parent="Widget.Material3.Slider">
        <item name="labelBehavior">gone</item>
        <item name="tickVisible">false</item>
        <item name="trackStopIndicatorSize">0dp</item>
        <item name="trackHeight">@dimen/slider_track_height</item>
        <item name="trackCornerSize">@dimen/slider_track_height</item>
        <item name="trackInsideCornerSize">@dimen/slider_track_height</item>
        <item name="thumbHeight">@dimen/slider_thumb_height</item>
    </style>

    <!-- Library shortcuts. The outlined role is the one the playback panel's repeat and shuffle
         toggles wear, so the row still reads as cards rather than as filled targets. The weight
         divides the row evenly and the height is fixed, so the tabs below never shift; the insets
         are dropped so that height is what actually gets painted. -->
    <style name="Widget.LibraryShortcut" parent="Widget.Material3Expressive.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/size_library_shortcut</item>
        <item name="android:layout_weight">1</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconGravity">top</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <!-- Set outright rather than through the size class, whose corners come from the fully
             rounded expressive default. The group carries the same shape, since it is the group
             that shapes the outer corners of the first and last card. -->
        <item name="shapeAppearance">@xml/library_shortcut_shape</item>
        <item name="iconPadding">@dimen/spacing_tiny</item>
    </style>

</resources>
