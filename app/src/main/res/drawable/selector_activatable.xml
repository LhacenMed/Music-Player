<?xml version="1.0" encoding="utf-8"?><!--
    The multi-select highlight, keyed on the activated state rather than the selected one so that
    "selected" is left free to mean "this is the track the player is on", as it does in Auxio.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item android:drawable="@color/sel_item_activated_bg" />
</ripple>
